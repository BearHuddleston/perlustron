{
  "name": "perlustron",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run build:frontend",
    "build:frontend": "esbuild src/frontend/app.ts --bundle --format=esm --target=es2022 --minify --outfile=static/app.js && node scripts/clean-built-js.mjs",
    "dev": "npm run build:frontend && cargo run -- --demo --no-open --dev-assets",
    "dev:frontend": "esbuild src/frontend/app.ts --bundle --format=esm --target=es2022 --outfile=static/app.js --watch",
    "bench:smoke": "cargo run --quiet -- bench --generate 250 --append-lines 25 --max-full-ms 1000 --max-status-ms 1000 --max-append-ms 1000",
    "smoke:browser": "npm run build:frontend && node scripts/smoke-browser.mjs",
    "offline:check": "node scripts/check-offline-assets.mjs",
    "ui:check": "node scripts/check-event-context-panel.mjs && node scripts/check-format-utils.mjs && node scripts/check-summary-mode-shell.mjs",
    "workflow:check": "node scripts/check-ci-workflow.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run offline:check && npm run ui:check && npm run workflow:check && cargo fmt --check && cargo test && cargo clippy --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.60.0",
    "three": "0.184.0",
    "typescript": "5.9.3"
  }
}
